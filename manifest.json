{
  "manifest_version": 3,
  "name": "Job Description Resumer",
  "version": "1.0.1",
  "description": "An extension that quickly shows the requirements of  job description. Currently only works on linkedin",
  "icons": {
    "48": "images/icon-48.png"
  },
  "content_scripts": [
    {
      "js": [
        "content-script.js"
      ],
      
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://www.itjobs.pt/*"
      ]
    }
  ] 
}