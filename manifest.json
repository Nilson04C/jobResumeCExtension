{
  "manifest_version": 3,
  "name": "Minimal Manifest",
  "version": "1.0.1",
  "description": "A basic example extension with only required keys",
  "icons": {
    "48": "images/icon-48.png"
  },
  "content_scripts": [
    {
      "js": [
        "content-script.js"
      ],
      
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://www.itjobs.pt/*"
      ]
    }
  ],

  "action": {
    "default_icon": {},
    "default_title": "Click Me",
    "default_popup": "popup.html"
  }
    
}